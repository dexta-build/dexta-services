// ---------------------------------------------------------------------------
// Catalogues (the shop). Prices are stored in naira; the site converts them
// to USD, EUR and GBP for display. Not yet pushed to the database: the
// public pages use sample data until the catalogue admin is built.
// ---------------------------------------------------------------------------

enum CatalogueMediaType {
  IMAGE
  VIDEO
  GIF
}

model Catalogue {
  id            String              @id @default(uuid())
  slug          String              @unique
  title         String
  description   String              @default("")
  /// Colour theme key used by the site (gold, coral, stone, lilac, mint, ice…)
  accent        String              @default("ice")
  /// Icon key used in menus (heart, party, flower, cake, monitor, briefcase…)
  icon          String              @default("heart")
  coverPublicId String?
  /// Optional hero heading for its page (*asterisks* for the accent); empty = "<title> catalogue"
  heroTitle     String?
  /// Optional hero text; empty = description plus the shared line
  heroText      String?
  /// Shown as an image card in the Catalogues menu (first two)
  isFeatured    Boolean             @default(false)
  /// Shown in the homepage catalogue showcase
  showOnHome    Boolean             @default(true)
  isVisible     Boolean             @default(true)
  position      Int                 @default(0)
  categories    CatalogueCategory[]
  items         CatalogueItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([position])
}

model CatalogueCategory {
  id          String          @id @default(uuid())
  catalogueId String
  catalogue   Catalogue       @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  isVisible   Boolean         @default(true)
  position    Int             @default(0)
  items       CatalogueItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([catalogueId, slug])
  @@index([catalogueId, position])
}

model CatalogueItem {
  id          String             @id @default(uuid())
  catalogueId String
  catalogue   Catalogue          @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    CatalogueCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug        String
  title       String
  description String             @default("")
  /// Price per unit in the item's currency (naira by default), whole units.
  price       Int
  currency    String             @default("NGN")
  /// Minimum order quantity
  moq         Int                @default(1)
  /// What one unit is: "card", "piece", "pack of 50", "project"…
  unit        String             @default("piece")
  tags        String             @default("[]") // JSON array of strings
  isFeatured  Boolean            @default(false)
  isVisible   Boolean            @default(true)
  /// Copied from the built-in samples (placeholder price); cleared when edited
  isSample    Boolean            @default(false)
  position    Int                @default(0)
  media       CatalogueMedia[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([catalogueId, slug])
  @@index([catalogueId, position])
  @@index([categoryId])
}

model CatalogueMedia {
  id                String             @id @default(uuid())
  itemId            String
  item              CatalogueItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  publicId          String
  mediaType         CatalogueMediaType @default(IMAGE)
  thumbnailPublicId String?
  alt               String?
  position          Int                @default(0)
  createdAt         DateTime           @default(now())

  @@index([itemId, position])
}

// --- Offers (public /offers page) ---

// One offer: not tied to any audience, so an offer can span design, build
// and print. Payment can be a payment link, WhatsApp, or both.
model Offer {
  id              String    @id @default(uuid())
  name            String
  description     String
  features        String    @default("[]") // JSON array of strings
  priceNGN        Int? // whole naira; empty = "Custom quote"
  priceNote       String? // e.g. "/ month", "one-off", "per project"
  badge           String? // free text, e.g. "Bundle", "Best value", "15% off"
  paymentLink     String? // Paystack / Flutterwave / Stripe / any URL
  whatsappEnabled Boolean   @default(true)
  startsAt        DateTime? // hidden until then
  endsAt          DateTime? // shows a countdown; hidden after
  isHighlighted   Boolean   @default(false)
  isVisible       Boolean   @default(true)
  position        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isVisible, position])
}

// --- Thoughts (blog at /thoughts) ---

enum PostStatus {
  DRAFT
  PUBLISHED
}

model PostCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("ice") // site surface: ice, mint, gold, lilac, coral, stone
  position    Int      @default(0)
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}

model Post {
  id             String           @id @default(uuid())
  title          String // wrap words in *asterisks* for the serif italic accent
  slug           String           @unique
  excerpt        String // card summary and the article's TL;DR
  content        String // rich-text HTML, sanitised before display
  coverPublicId  String? // Cloudinary public ID
  categoryId     String?
  category       PostCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId       String?
  author         AboutTeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags           String           @default("[]") // JSON array of strings
  isFeatured     Boolean          @default(false)
  status         PostStatus       @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured])
}
